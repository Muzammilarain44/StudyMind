# StudyMind server — copy to .env and fill in your own values. Never commit a real .env.
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:5173
# JWT secret for auth cookies. Generate a long random one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production refuses to start without it. Never commit a real value.
JWT_SECRET=<generate-a-long-random-string-at-least-32-chars>
# Admin access (Phase 5): there is no env var for this — admins are made with
#   node scripts/promote-admin.js <email>
# and sample content is seeded with
#   node scripts/seed-samples.js <admin-email>
# Both need MONGODB_URI set (above). See docs/setup.md.
