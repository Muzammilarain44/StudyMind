# StudyMind — copy the relevant lines into server/.env and client/.env as needed.
# Placeholders only. Never commit a real .env with real credentials.
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:5173
# JWT secret for auth cookies. Generate a long random one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production refuses to start without it. Never commit a real value.
JWT_SECRET=<generate-a-long-random-string-at-least-32-chars>
VITE_API_URL=http://localhost:5000
# Admin access (Phase 5): no env var — promote an existing user with
#   node scripts/promote-admin.js <email>   (run from server/)
# and seed sample content with
#   node scripts/seed-samples.js <admin-email>
